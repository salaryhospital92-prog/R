# عنوان الوكيل على نطاق المتجر نفسه (افتراضياً /api على نفس النطاق)
# VITE_API_URL=
# مفتاح anon (علني بطبيعته؛ الوكيل في الإنتاج يستبدله). محلياً يولّده dev/stack.mjs في .env.development.local
VITE_ANON_KEY=
# النطاق الجذر لمتاجر المروّجين: متجر.النطاق. فارغ = مسار /s/:slug (أو *.localhost) فقط
VITE_ROOT_DOMAIN=
