-- =====================================================================
-- 017 — متاجر المروّجين: الجداول والصلاحيات  (مسودة — لم تُطبَّق)
-- =====================================================================
-- صلاحيات المشروع الافتراضية تمنح anon وauthenticated كل شيء على أي جدول أو
-- دالة جديدة. لذلك: سحب كل شيء صراحةً ثم منح ما يلزم فقط، بلا أي view.
-- المال يُكتب بالدوال وحدها (019)؛ لا منحة كتابة عليه لأحد ولا لـservice_role.
-- =====================================================================
set local lock_timeout = '5s';

-- ---------------------------------------------------------------------
-- الإعدادات — كل قرارات المالك الافتراضية هنا وفي مكان واحد
-- ---------------------------------------------------------------------
insert into public.app_settings (key, value) values
  ('reseller_orders_enabled',       'off'),     -- قاطع الطوارئ: off يوقف طلبات كل متاجر المروّجين
  ('reseller_base',                 'retail'),  -- أساس المروّج: retail أو wholesale
  ('reseller_max_markup_percent',   ''),        -- سقف الزيادة فوق الأساس بالمئة؛ فارغ = بلا سقف
  ('reseller_hold_days',            '3'),       -- أيام بين «مُسلَّم» واستحقاق الربح؛ 0 = فوراً
  ('reseller_payout_threshold',     '25000'),   -- طلب تحويل تلقائي عند هذا المتاح؛ 0 = بلا تلقائي
  ('reseller_show_customer_phone',  'off'),     -- on = المروّج يرى هاتف الزبون وملاحظته
  ('reseller_url',                  '')         -- نطاق المتاجر عندما يُشترى
on conflict (key) do nothing;

create or replace function public.reseller_cfg(p_key text) returns text
language sql stable security definer set search_path = public as $$
  select nullif(trim(value), '') from public.app_settings where key = p_key and key like 'reseller\_%'
$$;
-- قيمة تالفة أو سالبة ← الافتراضي، ولا تُسقط المتجر
create or replace function public.reseller_num(p_key text, p_default numeric) returns numeric
language sql stable security definer set search_path = public as $$
  select case when public.reseller_cfg(p_key) ~ '^\d{1,9}(\.\d+)?$'
              then public.reseller_cfg(p_key)::numeric else p_default end
$$;

-- ---------------------------------------------------------------------
-- المتاجر
-- ---------------------------------------------------------------------
create or replace function public.reseller_slug_ok(p text) returns boolean
language sql immutable set search_path = public as $$
  select p ~ '^[a-z0-9](-?[a-z0-9]){2,29}$'
     and p !~ 'rifa(i|e|y)|refai|rafai|alrifa'          -- انتحال اسم الرفاعي
     and p <> all (array['www','api','app','admin','dashboard','login','logout','signup','account','assets',
       'static','cdn','img','images','store','stores','shop','checkout','cart','mail','smtp','ftp','blog',
       'help','support','status','test','dev','staging','mona','almona','zad','supabase','auth','rest',
       'reseller','resellers','index','robots','sitemap','favicon','manifest'])
$$;

create table public.reseller_stores (
  id            uuid primary key default gen_random_uuid(),
  owner_id      uuid not null unique references auth.users(id) on delete restrict,
  slug          text not null unique check (public.reseller_slug_ok(slug)),
  name          text not null check (length(trim(name)) between 2 and 40),
  logo_path     text check (length(logo_path) <= 200),
  theme_color   text not null default '#059669' check (theme_color ~ '^#[0-9a-f]{6}$'),
  phone         text not null check (phone ~ '^9647\d{9}$'),    -- خاص بالمدير
  whatsapp      text check (whatsapp ~ '^9647\d{9}$'),          -- علني في المتجر
  about         text check (length(about) <= 500),
  status        text not null default 'draft' check (status in ('draft','pending','active','suspended','rejected')),
  status_reason text,
  decided_by    text,
  decided_at    timestamptz,
  markup_type   text not null default 'percent' check (markup_type in ('fixed','percent')),
  markup_value  bigint not null default 0 check (markup_value between 0 and 10000000),
  round_to      int not null default 250 check (round_to in (1, 250, 500, 1000)),
  created_at    timestamptz not null default now(),
  check (markup_type <> 'percent' or markup_value <= 1000)
);

create table public.reseller_categories (
  store_id    uuid not null references public.reseller_stores(id) on delete cascade,
  category_id int  not null references public.categories(id) on delete cascade,
  primary key (store_id, category_id)
);

create table public.reseller_products (
  store_id            uuid not null references public.reseller_stores(id) on delete cascade,
  product_id          uuid not null references public.products(id) on delete cascade,
  is_visible          boolean not null default true,
  price_override      bigint check (price_override between 1 and 100000000),
  display_name        text check (length(trim(display_name)) between 2 and 120),
  display_description text check (length(display_description) <= 1000),
  primary key (store_id, product_id)
);

-- صور مكتوب عليها اسم الرفاعي: يعلّمها موظفو الرفاعي فلا تظهر في متاجر المروّجين
alter table public.products add column if not exists reseller_hidden boolean not null default false;

-- ---------------------------------------------------------------------
-- الطلبات
-- ---------------------------------------------------------------------
alter table public.orders add column if not exists reseller_store_id uuid references public.reseller_stores(id) on delete restrict;
alter table public.orders drop constraint orders_source_check;
alter table public.orders add constraint orders_source_check
  check (source in ('storefront', 'telegram', 'pos', 'mona', 'reseller'));
alter table public.orders add constraint orders_reseller_check
  check ((source = 'reseller') = (reseller_store_id is not null));
create index idx_orders_reseller on public.orders (reseller_store_id, created_at desc) where reseller_store_id is not null;

create table public.reseller_orders (
  order_id            uuid primary key references public.orders(id) on delete restrict,
  store_id            uuid not null references public.reseller_stores(id) on delete restrict,
  base_subtotal       bigint not null check (base_subtotal > 0),
  reseller_subtotal   bigint not null,
  profit              bigint not null generated always as (reseller_subtotal - base_subtotal) stored check (profit >= 0),
  base_mode           text   not null,
  cycle               int    not null default 0,       -- عدد مرات بلوغ «مُسلَّم»
  cancel_requested_at timestamptz,
  cancel_reason       text check (length(cancel_reason) <= 300)
);
create index on public.reseller_orders (store_id);

create table public.reseller_order_items (
  order_id     uuid not null references public.reseller_orders(order_id) on delete restrict,
  line_no      int  not null,
  product_id   uuid not null,                          -- لقطة: لا مفتاح خارجي
  display_name text not null,
  qty          int  not null check (qty > 0),          -- قطع
  pack_qty     int,
  unit_price   bigint not null,                        -- ثمن القطعة أو العلبة عند المروّج
  base_total   bigint not null check (base_total > 0),
  sell_total   bigint not null,
  primary key (order_id, line_no),
  check (sell_total >= base_total)
);

-- ---------------------------------------------------------------------
-- المال
-- ---------------------------------------------------------------------
create table public.reseller_payout_accounts (
  id          uuid primary key default gen_random_uuid(),
  seq         bigint generated always as identity,     -- «الأحدث» بالتسلسل لا بالساعة: الساعة قد ترجع
  store_id    uuid not null references public.reseller_stores(id) on delete restrict,
  method      text not null check (method in ('zaincash', 'qicard')),
  account_no  text not null,
  holder_name text not null check (length(trim(holder_name)) between 2 and 80 and holder_name !~ '\d{4}'),
  is_current  boolean not null default true,
  created_at  timestamptz not null default now(),
  -- زين كاش رقم هاتف؛ كي كارد رقم حساب فقط: 16 رقماً فأكثر = رقم بطاقة ويُرفض
  check (case method when 'zaincash' then account_no ~ '^07\d{9}$' else account_no ~ '^\d{6,15}$' end)
);
create unique index on public.reseller_payout_accounts (store_id, method) where is_current;

create table public.reseller_payouts (
  id         uuid primary key default gen_random_uuid(),
  seq        bigint generated always as identity,
  store_id   uuid not null references public.reseller_stores(id) on delete restrict,
  account_id uuid not null references public.reseller_payout_accounts(id) on delete restrict,
  amount     bigint not null check (amount > 0),
  origin     text not null check (origin in ('auto', 'manual')),
  status     text not null default 'open' check (status in ('open', 'paid', 'cancelled', 'rejected')),
  reference  text check (length(reference) <= 100),
  reason     text check (length(reason) <= 300),
  decided_by text,
  decided_at timestamptz,
  created_at timestamptz not null default clock_timestamp(),
  check (status <> 'paid' or length(trim(coalesce(reference, ''))) >= 2)
);
create unique index reseller_payouts_one_open on public.reseller_payouts (store_id) where status = 'open';
create index on public.reseller_payouts (store_id, created_at desc);

create table public.reseller_ledger (
  id           bigint generated always as identity primary key,
  store_id     uuid not null references public.reseller_stores(id) on delete restrict,
  kind         text not null check (kind in ('profit_due', 'reversal', 'payout', 'adjustment')),
  amount       bigint not null check (amount <> 0),
  available_at timestamptz not null default now(),     -- نهاية مهلة الاستحقاق
  order_id     uuid references public.reseller_orders(order_id) on delete restrict,
  cycle        int,
  payout_id    uuid references public.reseller_payouts(id) on delete restrict,
  note         text check (length(note) <= 300),
  created_by   text,
  created_at   timestamptz not null default now(),
  check ((kind in ('profit_due', 'reversal')) = (order_id is not null and cycle is not null)),
  check ((kind = 'payout') = (payout_id is not null)),
  check (kind <> 'profit_due' or amount > 0),
  check (kind not in ('reversal', 'payout') or amount < 0)
);
create unique index reseller_ledger_order_once  on public.reseller_ledger (order_id, kind, cycle) where order_id is not null;
create unique index reseller_ledger_payout_once on public.reseller_ledger (payout_id) where payout_id is not null;
create index on public.reseller_ledger (store_id, available_at);

create table public.reseller_audit (
  id         bigint generated always as identity primary key,
  store_id   uuid not null,
  actor      text not null,
  action     text not null,
  detail     text,
  created_at timestamptz not null default now()
);

-- السجل لا يُعدَّل ولا يُحذف — حتى من service_role ومالك الجداول
create or replace function public.reseller_immutable() returns trigger
language plpgsql set search_path = public as $$
begin
  raise exception 'سجل لا يُعدَّل ولا يُحذف (%)', tg_table_name;
end $$;
create trigger trg_reseller_ledger_immutable before update or delete on public.reseller_ledger
  for each row execute function public.reseller_immutable();
create trigger trg_reseller_ledger_no_truncate before truncate on public.reseller_ledger
  for each statement execute function public.reseller_immutable();
create trigger trg_reseller_audit_immutable before update or delete on public.reseller_audit
  for each row execute function public.reseller_immutable();
create trigger trg_reseller_items_immutable before update or delete on public.reseller_order_items
  for each row execute function public.reseller_immutable();
create trigger trg_reseller_account_immutable before update of id, store_id, method, account_no, holder_name, created_at or delete
  on public.reseller_payout_accounts for each row execute function public.reseller_immutable();

-- لقطة الطلب: المبالغ لا تتغيّر بعد الإنشاء (cycle وطلب الإلغاء فقط)
create trigger trg_reseller_order_snapshot before update of order_id, store_id, base_subtotal, reseller_subtotal, base_mode or delete
  on public.reseller_orders for each row execute function public.reseller_immutable();

-- ---------------------------------------------------------------------
-- طلب توفير منتج، وربط تيليغرام
-- ---------------------------------------------------------------------
create table public.reseller_product_requests (
  id           uuid primary key default gen_random_uuid(),
  store_id     uuid not null references public.reseller_stores(id) on delete cascade,
  name         text not null check (length(trim(name)) between 2 and 120),
  image_path   text check (length(image_path) <= 200),
  url          text check (url ~ '^https://' and length(url) <= 500),
  expected_qty int check (expected_qty between 1 and 100000),
  note         text check (length(note) <= 500),
  status       text not null default 'new' check (status in ('new', 'reviewing', 'available', 'rejected')),
  reply        text check (length(reply) <= 500),
  product_id   uuid references public.products(id) on delete set null,
  created_at   timestamptz not null default now()
);
create index on public.reseller_product_requests (store_id, created_at desc);

create table public.reseller_telegram (
  store_id        uuid primary key references public.reseller_stores(id) on delete cascade,
  chat_id         bigint unique,
  code            text unique,
  code_expires_at timestamptz,
  linked_at       timestamptz
);

-- ---------------------------------------------------------------------
-- الصلاحيات
-- ---------------------------------------------------------------------
create or replace function public.reseller_my_store() returns uuid
language sql stable security definer set search_path = public as $$
  select id from public.reseller_stores where owner_id = auth.uid()
$$;
create or replace function public.reseller_can_edit() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.reseller_stores where owner_id = auth.uid() and status <> 'suspended')
$$;

do $$
declare t text;
begin
  foreach t in array array['reseller_stores','reseller_categories','reseller_products','reseller_orders',
    'reseller_order_items','reseller_payout_accounts','reseller_payouts','reseller_ledger','reseller_audit',
    'reseller_product_requests','reseller_telegram'] loop
    execute format('alter table public.%I enable row level security', t);
    execute format('revoke all on public.%I from public, anon, authenticated', t);
  end loop;
  -- المال بالدوال وحدها، ولا يكتبه أحد مباشرةً ولو بمفتاح الخدمة
  foreach t in array array['reseller_payout_accounts','reseller_payouts','reseller_ledger','reseller_orders',
    'reseller_order_items','reseller_audit'] loop
    execute format('revoke insert, update, delete, truncate on public.%I from service_role', t);
  end loop;
end $$;
revoke select on public.reseller_payout_accounts from service_role;   -- الحساب الكامل لا يقرؤه البوت

grant select on public.reseller_stores, public.reseller_orders, public.reseller_order_items,
  public.reseller_ledger, public.reseller_payouts, public.reseller_payout_accounts, public.reseller_audit to authenticated;
grant select, insert, delete on public.reseller_categories to authenticated;
grant select, insert, update, delete on public.reseller_products to authenticated;
grant select on public.reseller_product_requests to authenticated;
grant insert (store_id, name, image_path, url, expected_qty, note) on public.reseller_product_requests to authenticated;
grant update (status, reply, product_id) on public.reseller_product_requests to authenticated;

create policy stores_read on public.reseller_stores for select to authenticated
  using (owner_id = auth.uid() or public.is_supervisor());

create policy categories_own on public.reseller_categories for all to authenticated
  using (store_id = (select public.reseller_my_store()) and (select public.reseller_can_edit()))
  with check (store_id = (select public.reseller_my_store()) and (select public.reseller_can_edit()));
create policy categories_admin on public.reseller_categories for select to authenticated using (public.is_admin());

create policy products_own on public.reseller_products for all to authenticated
  using (store_id = (select public.reseller_my_store()) and (select public.reseller_can_edit()))
  with check (store_id = (select public.reseller_my_store()) and (select public.reseller_can_edit()));
create policy products_admin on public.reseller_products for select to authenticated using (public.is_admin());

create policy orders_read on public.reseller_orders for select to authenticated
  using (store_id = (select public.reseller_my_store()) or public.is_admin());
create policy items_read on public.reseller_order_items for select to authenticated
  using (exists (select 1 from public.reseller_orders o where o.order_id = reseller_order_items.order_id));  -- RLS الأب تسري
create policy ledger_read on public.reseller_ledger for select to authenticated
  using (store_id = (select public.reseller_my_store()) or public.is_admin());
create policy payouts_read on public.reseller_payouts for select to authenticated
  using (store_id = (select public.reseller_my_store()) or public.is_admin());
-- المدير يكشف الحساب بدالة تُسجَّل (reseller_payout_reveal) لا بقراءة الجدول
create policy accounts_read on public.reseller_payout_accounts for select to authenticated
  using (store_id = (select public.reseller_my_store()));
create policy audit_read on public.reseller_audit for select to authenticated using (public.is_admin());

create policy requests_read on public.reseller_product_requests for select to authenticated
  using (store_id = (select public.reseller_my_store()) or public.is_supervisor());
create policy requests_add on public.reseller_product_requests for insert to authenticated
  with check (store_id = (select public.reseller_my_store()) and (select public.reseller_can_edit()));
create policy requests_admin on public.reseller_product_requests for update to authenticated
  using (public.is_admin()) with check (public.is_admin());

-- 20 طلب توفير مفتوحاً لكل متجر
create or replace function public.reseller_request_limit() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  perform 1 from public.reseller_stores where id = new.store_id for no key update;
  if (select count(*) from public.reseller_product_requests
       where store_id = new.store_id and status in ('new', 'reviewing')) >= 20 then
    raise exception 'لديك 20 طلب توفير مفتوحاً — انتظر الرد عليها';
  end if;
  return new;
end $$;
create trigger trg_reseller_request_limit before insert on public.reseller_product_requests
  for each row execute function public.reseller_request_limit();

-- ---------------------------------------------------------------------
-- شعارات المتاجر: bucket مستقل، بلا SVG، كل مستخدم في مجلده
-- ---------------------------------------------------------------------
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('reseller-logos', 'reseller-logos', true, 1048576, array['image/png', 'image/jpeg', 'image/webp'])
on conflict (id) do update set public = true, file_size_limit = excluded.file_size_limit,
  allowed_mime_types = excluded.allowed_mime_types;

create policy reseller_logos_insert on storage.objects for insert to authenticated
  with check (bucket_id = 'reseller-logos' and (storage.foldername(name))[1] = auth.uid()::text);
create policy reseller_logos_update on storage.objects for update to authenticated
  using (bucket_id = 'reseller-logos' and (storage.foldername(name))[1] = auth.uid()::text)
  with check (bucket_id = 'reseller-logos' and (storage.foldername(name))[1] = auth.uid()::text);
create policy reseller_logos_read on storage.objects for select to authenticated
  using (bucket_id = 'reseller-logos' and (storage.foldername(name))[1] = auth.uid()::text);
create policy reseller_logos_delete on storage.objects for delete to authenticated
  using (bucket_id = 'reseller-logos' and (storage.foldername(name))[1] = auth.uid()::text);

revoke all on function public.reseller_cfg(text), public.reseller_num(text, numeric), public.reseller_slug_ok(text),
  public.reseller_immutable(), public.reseller_request_limit(), public.reseller_my_store(), public.reseller_can_edit()
  from public, anon, authenticated;
grant execute on function public.reseller_my_store(), public.reseller_can_edit() to authenticated;
