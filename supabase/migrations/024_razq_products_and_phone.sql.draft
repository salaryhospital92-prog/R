-- =====================================================================
-- 024 — رزق: الدخول بالهاتف وكلمة سر، اختيار المنتجات والمقترحة، منتجات المروّج الخاصة وطلباتها،
--        وموافقات الإدارة عبر بوت رزق  (مسودة — لم تُطبَّق)
-- =====================================================================
-- قرارات المالك (2026-11-26): منتجات المروّج الخاصة لا تظهر إلا بعد موافقة الإدارة؛ يرى المروّج هاتف الزبون
-- لطلبات منتجاته الخاصة فقط؛ الدخول بالهاتف وكلمة سر بجانب تيليغرام (محظور في العراق).
-- منتجات المروّج الخاصة خارج orders تماماً: لا زاد ولا مخزون ولا قيود ربح ولا تقارير الرفاعي.
-- =====================================================================
set local lock_timeout = '5s';

-- ---------------------------------------------------------------------
-- 1) الهوية: مستخدم هاتف بلا تيليغرام
-- ---------------------------------------------------------------------
alter table public.reseller_identities drop constraint reseller_identities_pkey;
alter table public.reseller_identities add primary key (user_id);
alter table public.reseller_identities alter column telegram_id drop not null;
alter table public.reseller_identities add constraint reseller_identities_telegram_key unique (telegram_id);

-- تسجيل بالهاتف وكلمة سر (يدخل بعدها signInWithPassword ببريد تركيبي ph<الهاتف>@phone.invalid).
-- الرقم لا يُتحقق منه آلياً: يتصل به مدير الرفاعي قبل تفعيل المتجر.
create or replace function public.reseller_phone_register(p_phone text, p_password text, p_name text) returns jsonb
language plpgsql security definer set search_path = public, extensions as $$
declare v_phone text := public.zad_canonical_phone(p_phone); v_user uuid := gen_random_uuid(); v_email text;
begin
  if v_phone is null or v_phone !~ '^9647\d{9}$' then raise exception 'أدخل رقم موبايل عراقي صحيح'; end if;
  if length(coalesce(p_password, '')) not between 8 and 72 then raise exception 'كلمة السر من 8 أحرف على الأقل'; end if;
  if length(trim(coalesce(p_name, ''))) not between 2 and 80 then raise exception 'اكتب اسمك'; end if;
  perform pg_advisory_xact_lock(hashtext('reseller_phone_register'));
  if (select count(*) from auth.users where raw_app_meta_data ? 'reseller_phone' and created_at > now() - interval '1 hour') >= 30 then
    raise exception 'تسجيلات كثيرة الآن — حاول بعد قليل';
  end if;
  v_email := 'ph' || v_phone || '@phone.invalid';
  if exists (select 1 from public.reseller_identities where phone = v_phone) or exists (select 1 from auth.users where email = v_email) then
    raise exception 'هذا الرقم مسجَّل — ادخل بكلمة السر أو بتيليغرام';
  end if;
  insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
                          confirmation_token, recovery_token, email_change_token_new, email_change)
  values ('00000000-0000-0000-0000-000000000000', v_user, 'authenticated', 'authenticated', v_email,
          crypt(p_password, gen_salt('bf', 10)), now(),
          jsonb_build_object('provider', 'email', 'providers', jsonb_build_array('email'), 'reseller_phone', v_phone), '{}'::jsonb, now(), now(),
          '', '', '', '');
  insert into auth.identities (provider_id, user_id, identity_data, provider, created_at, updated_at)
  values (v_user::text, v_user, jsonb_build_object('sub', v_user::text, 'email', v_email, 'email_verified', true), 'email', now(), now());
  insert into public.reseller_identities (telegram_id, user_id, name, phone, last_login_at) values (null, v_user, left(trim(p_name), 80), v_phone, now());
  return jsonb_build_object('email', v_email);
end $$;

-- ---------------------------------------------------------------------
-- 2) اختيار المنتجات والمقترحة
-- ---------------------------------------------------------------------
-- ما يُختار يظهر وما سواه في أصناف المتجر يُخفى. منتج جديد يضيفه الرفاعي لاحقاً يظهر تلقائياً.
create or replace function public.reseller_pick_products(p_ids uuid[]) returns int
language plpgsql security definer set search_path = public as $$
declare s uuid := public.reseller_my_store();
begin
  if s is null then raise exception 'أنشئ متجرك أولاً'; end if;
  if not public.reseller_can_edit() then raise exception 'متجرك موقوف — راجع الإدارة'; end if;
  if coalesce(cardinality(p_ids), 0) = 0 then raise exception 'اختر منتجاً واحداً على الأقل'; end if;
  insert into public.reseller_products (store_id, product_id, is_visible)
  select s, p.id, p.id = any (p_ids)
    from public.products p join public.reseller_categories rc on rc.store_id = s and rc.category_id = p.category_id
   where p.is_active and p.store = 'rifai'
  on conflict (store_id, product_id) do update set is_visible = excluded.is_visible;
  return (select count(*) from public.reseller_catalog() where is_visible);
end $$;

-- الأكثر مبيعاً عند الرفاعي أولاً، ثم الأربح للمروّج. للمعالج («مقترحة لك») وللوحة.
create or replace function public.reseller_suggestions(p_limit int default 12) returns table (product_id uuid, rank int)
language sql stable security definer set search_path = public as $$
  select c.product_id, (row_number() over (order by coalesce(pp.qty_sold, 0) desc, c.profit desc, c.product_id))::int
    from public.reseller_catalog() c left join public.popular_products pp on pp.product_id = c.product_id
   where c.in_stock and c.base > 0
   order by 2 limit least(greatest(coalesce(p_limit, 12), 1), 50)
$$;

-- ---------------------------------------------------------------------
-- 3) منتجات المروّج الخاصة وطلباتها (يوصلها بنفسه)
-- ---------------------------------------------------------------------
alter table public.reseller_stores add column if not exists own_delivery_fee bigint not null default 0
  check (own_delivery_fee between 0 and 100000);

create table public.reseller_own_products (
  id           uuid primary key default gen_random_uuid(),
  store_id     uuid not null references public.reseller_stores(id) on delete cascade,
  name         text not null check (length(trim(name)) between 2 and 120),
  description  text check (length(description) <= 1000),
  price        bigint not null check (price between 250 and 100000000),
  image_path   text check (length(image_path) <= 200),
  is_available boolean not null default true,
  status       text not null default 'pending' check (status in ('pending', 'approved', 'rejected')),
  reason       text check (length(reason) <= 300),
  decided_by   text,
  decided_at   timestamptz,
  created_at   timestamptz not null default now(),
  updated_at   timestamptz not null default now()
);
create index on public.reseller_own_products (store_id);

create table public.reseller_own_orders (
  id                 uuid primary key default gen_random_uuid(),
  order_no           bigint generated always as identity,
  store_id           uuid not null references public.reseller_stores(id) on delete restrict,
  customer_name      text not null check (length(customer_name) between 2 and 120),
  customer_phone     text not null,
  zone               text not null,
  note               text check (length(note) <= 500),
  items              jsonb not null,
  subtotal           bigint not null check (subtotal > 0),
  delivery_fee       bigint not null check (delivery_fee >= 0),
  total              bigint not null,
  status             text not null default 'new' check (status in ('new', 'confirmed', 'delivered', 'cancelled')),
  main_order_number bigint,
  created_at         timestamptz not null default now(),
  updated_at         timestamptz not null default now(),
  check (total = subtotal + delivery_fee)
);
create index on public.reseller_own_orders (store_id, created_at desc);

alter table public.reseller_own_products enable row level security;
alter table public.reseller_own_orders enable row level security;
revoke all on public.reseller_own_products, public.reseller_own_orders from public, anon, authenticated, service_role;
grant select on public.reseller_own_products, public.reseller_own_orders to authenticated;
create policy own_products_read on public.reseller_own_products for select to authenticated
  using (store_id = (select public.reseller_my_store()) or public.is_admin());
-- هاتف الزبون ظاهر هنا لصاحب المتجر (قرار المالك: لطلباته الخاصة فقط)
create policy own_orders_read on public.reseller_own_orders for select to authenticated
  using (store_id = (select public.reseller_my_store()) or public.is_admin());

-- صور المنتجات الخاصة: حاوية مستقلة، كل مستخدم في مجلده، 100 ملف و2MB
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('reseller-products', 'reseller-products', true, 2097152, array['image/png', 'image/jpeg', 'image/webp'])
on conflict (id) do update set public = true, file_size_limit = excluded.file_size_limit, allowed_mime_types = excluded.allowed_mime_types;
create or replace function public.reseller_own_image_count() returns int
language sql stable security definer set search_path = public, storage as $$
  select count(*)::int from storage.objects
   where bucket_id = 'reseller-products' and (storage.foldername(name))[1] = auth.uid()::text
$$;
create policy reseller_products_insert on storage.objects for insert to authenticated
  with check (bucket_id = 'reseller-products' and (storage.foldername(name))[1] = auth.uid()::text
              and (select public.reseller_own_image_count()) < 100);
create policy reseller_products_update on storage.objects for update to authenticated
  using (bucket_id = 'reseller-products' and (storage.foldername(name))[1] = auth.uid()::text)
  with check (bucket_id = 'reseller-products' and (storage.foldername(name))[1] = auth.uid()::text);
create policy reseller_products_read on storage.objects for select to authenticated
  using (bucket_id = 'reseller-products' and (storage.foldername(name))[1] = auth.uid()::text);
create policy reseller_products_delete on storage.objects for delete to authenticated
  using (bucket_id = 'reseller-products' and (storage.foldername(name))[1] = auth.uid()::text);

-- ---------------------------------------------------------------------
-- 4) بوت رزق: الإرسال وإشعارات الإدارة
-- ---------------------------------------------------------------------
create or replace function public.reseller_razq_send(p_chat bigint, p_text text, p_buttons jsonb default null) returns void
language plpgsql security definer set search_path = public, extensions as $$
declare v_token text := public.reseller_secret('bot_token');
begin
  if v_token is null or p_chat is null then return; end if;
  perform net.http_post(url := 'https://api.telegram.org/bot' || v_token || '/sendMessage',
    body := jsonb_strip_nulls(jsonb_build_object('chat_id', p_chat, 'text', p_text,
      'reply_markup', case when p_buttons is not null then jsonb_build_object('inline_keyboard', p_buttons) end)));
exception when others then null;
end $$;

-- إشعار المديرين: ببوت رزق إن كان مضبوطاً (أزراره يعالجها الويبهوك في القاعدة)، وإلا ببوت الرفاعي كما في 018.
-- يصل المدير الذي ضغط Start في بوت رزق مرة واحدة.
create or replace function public.reseller_notify_admins(p_text text, p_buttons jsonb default null) returns void
language plpgsql security definer set search_path = public, extensions as $$
declare v_token text; v_chat text;
begin
  if public.reseller_secret('bot_token') is not null then
    for v_chat in select telegram_id::text from public.telegram_agents where is_active and role = 'admin' loop
      perform public.reseller_razq_send(v_chat::bigint, p_text, p_buttons);
    end loop;
    return;
  end if;
  select value into v_token from public.app_settings where key = 'telegram_bot_token';
  if coalesce(v_token, '') = '' then return; end if;
  for v_chat in
    select telegram_id::text from public.telegram_agents where is_active and role = 'admin'
    union
    select value from public.app_settings where key = 'telegram_chat_id' and nullif(value, '') is not null
  loop
    perform net.http_post(
      url     := 'https://api.telegram.org/bot' || v_token || '/sendMessage',
      headers := '{"Content-Type": "application/json"}'::jsonb,
      body    := jsonb_strip_nulls(jsonb_build_object('chat_id', v_chat, 'text', p_text,
                   'reply_markup', case when p_buttons is not null then jsonb_build_object('inline_keyboard', p_buttons) end)));
  end loop;
exception when others then null;
end $$;

-- صاحب المتجر (إن ربط تيليغرام)
create or replace function public.reseller_notify_owner(p_store uuid, p_text text) returns void
language sql security definer set search_path = public as $$
  select public.reseller_razq_send((select chat_id from public.reseller_telegram where store_id = p_store), p_text)
$$;

-- ---------------------------------------------------------------------
-- 5) منتجات المروّج: الحفظ والقرار والعرض
-- ---------------------------------------------------------------------
create or replace function public.reseller_own_save(p jsonb) returns uuid
language plpgsql security definer set search_path = public as $$
declare s public.reseller_stores; o public.reseller_own_products; v_id uuid := nullif(p->>'id', '')::uuid;
        v_name text; v_desc text; v_price bigint; v_img text; v_avail boolean; v_changed boolean;
begin
  select * into s from public.reseller_stores where owner_id = auth.uid() for no key update;
  if not found then raise exception 'أنشئ متجرك أولاً'; end if;
  if s.status = 'suspended' then raise exception 'متجرك موقوف — راجع الإدارة'; end if;
  if v_id is not null then
    select * into o from public.reseller_own_products where id = v_id and store_id = s.id for update;
    if not found then raise exception 'المنتج غير موجود'; end if;
  elsif (select count(*) from public.reseller_own_products where store_id = s.id) >= 100 then
    raise exception 'وصلت إلى 100 منتج خاص';
  end if;

  v_name  := case when p ? 'name' then trim(p->>'name') else o.name end;
  v_desc  := case when p ? 'description' then nullif(trim(p->>'description'), '') else o.description end;
  v_price := case when p ? 'price' then (p->>'price')::bigint else o.price end;
  v_img   := case when p ? 'image_path' then nullif(p->>'image_path', '') else o.image_path end;
  v_avail := coalesce((p->>'is_available')::boolean, o.is_available, true);
  if v_img is not null and v_img !~ ('^' || auth.uid() || '/[A-Za-z0-9._-]{1,80}\.(png|jpe?g|webp)$') then
    raise exception 'مسار الصورة غير صالح';
  end if;
  if v_name is null or length(v_name) not between 2 and 120 then raise exception 'اسم المنتج من حرفين إلى 120'; end if;
  if v_price is null or v_price not between 250 and 100000000 then raise exception 'السعر غير صالح'; end if;

  -- أي تغيير في المحتوى يعيده للمراجعة؛ الإتاحة وحدها لا
  v_changed := o.id is null or (v_name, v_desc, v_price, v_img) is distinct from (o.name, o.description, o.price, o.image_path);
  if o.id is null then
    insert into public.reseller_own_products (store_id, name, description, price, image_path, is_available)
    values (s.id, v_name, v_desc, v_price, v_img, v_avail) returning * into o;
  else
    update public.reseller_own_products set name = v_name, description = v_desc, price = v_price, image_path = v_img,
           is_available = v_avail, updated_at = now(),
           status = case when v_changed then 'pending' else status end, reason = case when v_changed then null else reason end
     where id = o.id returning * into o;
  end if;
  if v_changed then
    perform public.reseller_notify_admins('🆕 منتج خاص بانتظار المراجعة' || E'\nالمتجر: ' || s.name || E'\nالمنتج: ' || v_name
        || E'\nالسعر: ' || v_price || ' د.ع' || coalesce(E'\nالصورة: ' || v_img, E'\nبلا صورة'),
      jsonb_build_array(jsonb_build_array(
        jsonb_build_object('text', '✅ قبول', 'callback_data', 'opok:' || o.id),
        jsonb_build_object('text', '✖️ رفض',  'callback_data', 'opno:' || o.id))));
  end if;
  return o.id;
end $$;

create or replace function public.reseller_own_delete(p_id uuid) returns void
language plpgsql security definer set search_path = public as $$
begin
  if not public.reseller_can_edit() then raise exception 'متجرك موقوف — راجع الإدارة'; end if;
  delete from public.reseller_own_products where id = p_id and store_id = public.reseller_my_store();
  if not found then raise exception 'المنتج غير موجود'; end if;
end $$;

create or replace function public.reseller_own_set_fee(p_fee bigint) returns void
language plpgsql security definer set search_path = public as $$
begin
  if p_fee is null or p_fee not between 0 and 100000 then raise exception 'أجرة التوصيل من 0 إلى 100,000'; end if;
  update public.reseller_stores set own_delivery_fee = p_fee where owner_id = auth.uid() and status <> 'suspended';
  if not found then raise exception 'لا يمكن الحفظ الآن'; end if;
end $$;

-- قرار الإدارة (لوحة الويب أو زر البوت). من «بانتظار» فقط: الضغطة الثانية لا تجد ما تقرره.
create or replace function public.reseller_own_decide(p_id uuid, p_action text, p_reason text default null, p_telegram_id bigint default null) returns text
language plpgsql security definer set search_path = public as $$
declare v_actor text := public.reseller_actor(p_telegram_id); o public.reseller_own_products; v_to text;
begin
  v_to := case p_action when 'approve' then 'approved' when 'reject' then 'rejected' end;
  if v_to is null then raise exception 'إجراء غير معروف'; end if;
  if v_to = 'rejected' and length(trim(coalesce(p_reason, ''))) < 2 then raise exception 'اكتب السبب'; end if;
  update public.reseller_own_products set status = v_to, reason = left(trim(p_reason), 300), decided_by = v_actor, decided_at = now()
   where id = p_id and status = 'pending' returning * into o;
  if o.id is null then raise exception 'عولج سابقاً'; end if;
  insert into public.reseller_audit (store_id, actor, action, detail) values (o.store_id, v_actor, 'own_' || p_action, o.name);
  perform public.reseller_notify_owner(o.store_id, case v_to when 'approved' then '✅ قُبل منتجك «' || o.name || '» وصار يظهر في متجرك.'
                                                            else '✖️ لم يُقبل منتجك «' || o.name || '»: ' || coalesce(o.reason, '') end);
  return v_to;
end $$;

-- الزبون (anon): المقبول المتاح فقط، وأجرة توصيل المتجر
create or replace function public.reseller_store_own(p_slug text) returns jsonb
language sql stable security definer set search_path = public as $$
  select jsonb_build_object('delivery_fee', s.own_delivery_fee,
    'products', coalesce((select jsonb_agg(jsonb_build_object('id', o.id, 'name', o.name, 'description', o.description,
                                  'price', o.price, 'image_path', o.image_path) order by o.created_at desc)
                            from public.reseller_own_products o where o.store_id = s.id and o.status = 'approved' and o.is_available), '[]'::jsonb))
    from public.reseller_stores s where s.slug = lower(p_slug) and s.status = 'active'
$$;

-- ---------------------------------------------------------------------
-- 6) الدفع: منتجات الرفاعي بالمسار القائم كما هو، ومنتجات المتجر في طلب مستقل. معاملة واحدة.
-- ---------------------------------------------------------------------
create or replace function public.reseller_checkout(
  p_slug text, p_customer_name text, p_customer_phone text, p_items jsonb, p_own_items jsonb, p_zone_id int,
  p_note text default null, p_expected_total bigint default null, p_expected_own_total bigint default null
) returns jsonb language plpgsql security definer set search_path = public as $$
declare r jsonb; v_store public.reseller_stores; v_zone public.delivery_zones; v_phone text; v_cart jsonb; v_ok boolean;
        it record; o public.reseller_own_products; v_lines jsonb := '[]'; v_sub bigint := 0; v_order public.reseller_own_orders;
        n_rifai int := coalesce(jsonb_array_length(case when jsonb_typeof(p_items) = 'array' then p_items end), 0);
        n_own int := coalesce(jsonb_array_length(case when jsonb_typeof(p_own_items) = 'array' then p_own_items end), 0);
begin
  if n_rifai = 0 and n_own = 0 then raise exception 'السلة فارغة'; end if;
  if n_rifai > 0 then
    r := public.reseller_create_order(p_slug, p_customer_name, p_customer_phone, p_items, p_zone_id, p_note, p_expected_total);
  end if;
  if n_own = 0 then return jsonb_build_object('main', r); end if;

  if public.reseller_cfg('reseller_orders_enabled') is distinct from 'on' then raise exception 'الطلب متوقف مؤقتاً'; end if;
  select * into v_store from public.reseller_stores where slug = lower(p_slug) and status = 'active';
  if not found then raise exception 'المتجر غير متاح'; end if;
  if length(trim(coalesce(p_customer_name, ''))) not between 2 and 120 then raise exception 'الرجاء إدخال اسم الزبون'; end if;
  v_phone := public.zad_canonical_phone(p_customer_phone);
  if v_phone is null then raise exception 'الرجاء إدخال رقم هاتف صحيح'; end if;
  if length(p_note) > 500 then raise exception 'الملاحظة طويلة'; end if;
  select * into v_zone from public.delivery_zones where id = p_zone_id and is_active and zad_zone_id is not null;
  if not found then raise exception 'منطقة التوصيل غير متاحة'; end if;
  if n_own > 50 then raise exception 'قائمة المنتجات غير صالحة'; end if;
  begin
    select jsonb_agg(jsonb_build_object('id', id, 'qty', q) order by id), bool_and(id is not null and ok and m > 0 and q <= 100)
      into v_cart, v_ok
      from (select (i->>'product_id')::uuid id, sum((i->>'qty')::int) q, min((i->>'qty')::int) m, count(*) = count(i->>'qty') ok
              from jsonb_array_elements(p_own_items) i group by 1) t;
    if v_ok is not true then raise exception 'x'; end if;
  exception when others then raise exception 'كمية غير صالحة';
  end;

  perform pg_advisory_xact_lock(hashtext('reseller_own_order'), hashtext(v_phone));
  if (select count(*) from public.reseller_own_orders where created_at > now() - interval '1 hour'
       and public.zad_canonical_phone(customer_phone) = v_phone) >= 5 then
    raise exception 'طلبات كثيرة من هذا الرقم — حاول لاحقاً';
  end if;
  if (select count(*) from public.reseller_own_orders where store_id = v_store.id and status <> 'cancelled'
       and created_at > now() - interval '1 hour') >= 30 then
    raise exception 'المتجر مشغول الآن — حاول لاحقاً';
  end if;

  for it in select (c->>'id')::uuid id, (c->>'qty')::int qty from jsonb_array_elements(v_cart) c loop
    select * into o from public.reseller_own_products
     where id = it.id and store_id = v_store.id and status = 'approved' and is_available for share;
    if not found then raise exception 'أحد المنتجات لم يعد متوفراً في المتجر'; end if;
    v_sub := v_sub + o.price * it.qty;
    v_lines := v_lines || jsonb_build_object('product_id', o.id, 'name', o.name, 'qty', it.qty, 'unit_price', o.price, 'line_total', o.price * it.qty);
  end loop;
  if p_expected_own_total is not null and p_expected_own_total <> v_sub + v_store.own_delivery_fee then
    raise exception 'تغيّر السعر — راجع السلة';
  end if;

  insert into public.reseller_own_orders (store_id, customer_name, customer_phone, zone, note, items, subtotal, delivery_fee, total, main_order_number)
  values (v_store.id, trim(p_customer_name), trim(p_customer_phone), v_zone.name, nullif(trim(coalesce(p_note, '')), ''), v_lines,
          v_sub, v_store.own_delivery_fee, v_sub + v_store.own_delivery_fee, (r->>'order_number')::bigint)
  returning * into v_order;
  perform public.reseller_notify_owner(v_store.id, '🛍 طلب جديد لمنتجاتك الخاصة #' || v_order.order_no || E'\nالمجموع: ' || v_order.total
    || ' د.ع' || E'\nتوصيله عليك. التفاصيل في لوحة متجرك.');
  return jsonb_build_object('main', r, 'own', jsonb_build_object('order_no', v_order.order_no, 'subtotal', v_sub,
    'delivery_fee', v_order.delivery_fee, 'total', v_order.total, 'items', v_lines));
end $$;

-- صاحب المتجر يتابع طلباته الخاصة
create or replace function public.reseller_own_order_set(p_id uuid, p_status text) returns void
language plpgsql security definer set search_path = public as $$
declare v_from text[] := case p_status when 'confirmed' then array['new'] when 'delivered' then array['new', 'confirmed']
                                       when 'cancelled' then array['new', 'confirmed'] end;
begin
  if v_from is null then raise exception 'حالة غير معروفة'; end if;
  update public.reseller_own_orders set status = p_status, updated_at = now()
   where id = p_id and store_id = public.reseller_my_store() and status = any (v_from);
  if not found then raise exception 'لا يمكن تغيير حالة هذا الطلب'; end if;
end $$;

-- ---------------------------------------------------------------------
-- 7) الويبهوك: ما في 023 + أزرار المديرين (المتاجر والمنتجات الخاصة)
-- ---------------------------------------------------------------------
create or replace function public.reseller_bot_webhook(jsonb) returns jsonb
language plpgsql security definer set search_path = public, extensions as $$
declare
  u jsonb := $1; v_secret text := public.reseller_secret('webhook_secret'); v_given text;
  msg jsonb := $1->'message'; cbq jsonb := $1->'callback_query';
  v_from jsonb; v_chat jsonb; v_tg bigint; v_name text; v_text text; v_res text; v_opts int[]; v_nonce text; v_admin boolean;
  v_kind text; v_id uuid;
begin
  v_given := nullif(current_setting('request.headers', true), '')::jsonb ->> 'x-telegram-bot-api-secret-token';
  if v_secret is null or v_given is distinct from v_secret then return '{}'::jsonb; end if;

  v_from := coalesce(msg->'from', cbq->'from');
  v_chat := coalesce(msg->'chat', cbq->'message'->'chat');
  if v_from is null or v_chat->>'type' is distinct from 'private' then return '{}'::jsonb; end if;
  v_tg := (v_from->>'id')::bigint;
  v_name := concat_ws(' ', v_from->>'first_name', v_from->>'last_name');
  v_admin := exists (select 1 from public.telegram_agents where telegram_id = v_tg and is_active and role = 'admin');

  if cbq is not null then
    begin
      perform net.http_post(url := 'https://api.telegram.org/bot' || public.reseller_secret('bot_token') || '/answerCallbackQuery',
        body := jsonb_build_object('callback_query_id', cbq->>'id'));
    exception when others then null;
    end;

    -- أزرار المديرين: المتجر (rsok/rsno) والمنتج الخاص (opok/opno). reseller_actor يتحقق من المدير بنفسه.
    if coalesce(cbq->>'data', '') ~ '^(rsok|rsno|opok|opno):[0-9a-f-]{36}$' then
      if not v_admin then
        return jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg, 'text', 'هذه العملية لمدير الرفاعي فقط');
      end if;
      v_kind := split_part(cbq->>'data', ':', 1); v_id := split_part(cbq->>'data', ':', 2)::uuid;
      perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
      perform set_config('request.jwt.claim.role', 'service_role', true);
      begin
        v_text := case v_kind
          when 'rsok' then case public.reseller_decide_store(v_id, 'activate', null, v_tg) when 'active' then '✅ فُعّل المتجر' end
          when 'rsno' then case public.reseller_decide_store(v_id, 'reject', 'رفضته الإدارة', v_tg) when 'rejected' then '✖️ رُفض المتجر' end
          when 'opok' then case public.reseller_own_decide(v_id, 'approve', null, v_tg) when 'approved' then '✅ قُبل المنتج' end
          when 'opno' then case public.reseller_own_decide(v_id, 'reject', 'رفضته الإدارة', v_tg) when 'rejected' then '✖️ رُفض المنتج' end
        end;
      exception when others then v_text := sqlerrm;
      end;
      perform set_config('request.jwt.claims', '', true);
      perform set_config('request.jwt.claim.role', '', true);
      return jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg, 'text', coalesce(v_text, 'تم'));
    end if;

    if coalesce(cbq->>'data', '') !~ '^lp:[0-9a-f]{16}:\d{2}$' then return '{}'::jsonb; end if;
    v_res := public.reseller_login_pick(split_part(cbq->>'data', ':', 2), v_tg, split_part(cbq->>'data', ':', 3)::int);
    v_text := case v_res when 'confirmed' then 'تم ✅ ارجع الآن إلى المتصفح.'
                         when 'need_phone' then 'خطوة أخيرة: شارك رقم هاتفك بالزر أدناه ليتأكد المتجر منك (مرة واحدة فقط).'
                         when 'wrong' then 'الرقم غير صحيح، أُلغيت المحاولة. أعد الدخول من الموقع.'
                         else 'انتهت صلاحية المحاولة. أعد الدخول من الموقع.' end;
    return jsonb_strip_nulls(jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg, 'text', v_text,
      'reply_markup', case when v_res = 'need_phone' then jsonb_build_object(
        'keyboard', jsonb_build_array(jsonb_build_array(jsonb_build_object('text', '📱 مشاركة رقمي', 'request_contact', true))),
        'resize_keyboard', true, 'one_time_keyboard', true) end));
  end if;

  if msg->'contact' is not null then
    v_res := public.reseller_login_phone(v_tg, (msg->'contact'->>'user_id')::bigint, msg->'contact'->>'phone_number');
    v_text := case v_res when 'ok' then 'تم ✅ ارجع الآن إلى المتصفح.'
                         when 'not_yours' then 'شارك رقمك أنت بالزر أسفل الشاشة، لا جهة اتصال أخرى.'
                         when 'bad_phone' then 'المنصة لأرقام العراق فقط.'
                         else 'انتهت صلاحية المحاولة. أعد الدخول من الموقع.' end;
    return jsonb_strip_nulls(jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg, 'text', v_text,
      'reply_markup', case when v_res = 'ok' then jsonb_build_object('remove_keyboard', true) end));
  end if;

  v_nonce := substring(trim(coalesce(msg->>'text', '')) from '^/start login_([0-9a-f]{16})$');
  if v_nonce is null then
    return jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg, 'text', case when v_admin
      then E'أهلاً 👋\nأنت مدير: ستصلك هنا طلبات تفعيل المتاجر ومراجعة المنتجات الخاصة، بأزرار القبول والرفض.'
      else E'أهلاً 👋\nللدخول إلى رزق: افتح الموقع واضغط «الدخول عبر تيليغرام».' end);
  end if;
  v_opts := public.reseller_login_claim(v_nonce, v_tg, v_name);
  if v_opts is null then
    return jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg, 'text', 'انتهت صلاحية المحاولة. أعد الدخول من الموقع.');
  end if;
  return jsonb_build_object('method', 'sendMessage', 'chat_id', v_tg,
    'text', E'تسجيل الدخول إلى رزق 🔐\nاضغط الرقم الظاهر على شاشة المتصفح.\nإن لم تكن أنت من طلب الدخول فتجاهل هذه الرسالة.',
    'reply_markup', jsonb_build_object('inline_keyboard', jsonb_build_array(
      (select jsonb_agg(jsonb_build_object('text', x::text, 'callback_data', 'lp:' || v_nonce || ':' || x) order by i)
         from unnest(v_opts) with ordinality t(x, i)))));
exception when others then
  raise warning 'reseller_bot_webhook: %', sqlerrm;
  return '{}'::jsonb;
end $$;

-- ---------------------------------------------------------------------
-- الصلاحيات
-- ---------------------------------------------------------------------
revoke all on function public.reseller_phone_register(text, text, text), public.reseller_pick_products(uuid[]),
  public.reseller_suggestions(int), public.reseller_own_image_count(), public.reseller_razq_send(bigint, text, jsonb),
  public.reseller_notify_owner(uuid, text), public.reseller_own_save(jsonb), public.reseller_own_delete(uuid),
  public.reseller_own_set_fee(bigint), public.reseller_own_decide(uuid, text, text, bigint), public.reseller_store_own(text),
  public.reseller_checkout(text, text, text, jsonb, jsonb, int, text, bigint, bigint), public.reseller_own_order_set(uuid, text)
  from public, anon, authenticated, service_role;
revoke all on function public.reseller_notify_admins(text, jsonb), public.reseller_bot_webhook(jsonb) from public, anon, authenticated, service_role;
grant execute on function public.reseller_bot_webhook(jsonb) to anon, authenticated;
grant execute on function public.reseller_phone_register(text, text, text), public.reseller_store_own(text),
  public.reseller_checkout(text, text, text, jsonb, jsonb, int, text, bigint, bigint) to anon, authenticated;
grant execute on function public.reseller_pick_products(uuid[]), public.reseller_suggestions(int), public.reseller_own_image_count(),
  public.reseller_own_save(jsonb), public.reseller_own_delete(uuid), public.reseller_own_set_fee(bigint),
  public.reseller_own_decide(uuid, text, text, bigint), public.reseller_own_order_set(uuid, text) to authenticated;
